{
  "name": "configure",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "pi-extensions/*",
    "pi-config",
    "pi-skills",
    "pi-themes",
    "pi-agents",
    "mcp",
    "settings",
    "tools/*"
  ],
  "scripts": {
    "deploy": "turbo run deploy",
    "check-docs": "bun run tools/check-docs/index.ts",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "@typescript/native-preview": "^7.0.0-beta",
    "@vitest/coverage-v8": "^4.1.7",
    "turbo": "^2"
  }
}
