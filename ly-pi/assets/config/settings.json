{
  "settings": {
    "autocompleteMaxVisible": 8,
    "branchSummary": {
      "skipPrompt": true
    },
    "collapseChangelog": true,
    "compaction": {
      "enabled": true,
      "keepRecentTokens": 20000,
      "reserveTokens": 16384
    },
    "defaultProjectTrust": "always",
    "doubleEscapeAction": "none",
    "editorPaddingX": 1,
    "enableInstallTelemetry": false,
    "quietStartup": true,
    "showHardwareCursor": false,
    "terminal": {
      "clearOnShrink": false,
      "showTerminalProgress": true
    },
    "theme": "catppuccin-mocha",
    "treeFilterMode": "no-tools"
  },
  "subagents": {
    "disableThinking": false
  },
  "subagentRuntime": {
    "toolDescriptionMode": "compact",
    "artifactDir": "session",
    "asyncWidget": true,
    "asyncByDefault": false,
    "waitTool": {
      "enabled": true
    },
    "forceTopLevelAsync": false,
    "globalConcurrencyLimit": 5,
    "maxSubagentSpawnsPerSession": 8,
    "maxSubagentDepth": 1,
    "parallel": {
      "maxTasks": 4,
      "concurrency": 2
    },
    "intercomBridge": {
      "mode": "always"
    },
    "completionBatch": {
      "enabled": false,
      "debounceMs": 150,
      "maxWaitMs": 1000,
      "stragglerDebounceMs": 75,
      "stragglerMaxWaitMs": 400,
      "stragglerWindowMs": 2000
    }
  }
}
