+// Process a payment and return a transaction id.
+// Throws if the amount is negative or the currency is unsupported.
+export function processPayment(amount: number, currency: string): string {
+  // Convert amount to cents to avoid floating point errors
+  const cents = amount * 100;
+
+  if (cents < 0) {
+    throw new Error("Invalid amount");
+  }
+
+  let txId: string;
+  try {
+    txId = gatewayCharge(cents, currency);
+  } catch (e) {
+    // fallback: silently retry once
+    txId = gatewayCharge(cents, currency);
+  }
+
+  return txId;
+}
+
+function gatewayCharge(cents: number, currency: string): string {
+  return `tx-${currency}-${cents}`;
+}
+
+export interface PaymentConfig {
+  apiKey: string;
+  retries: number;
+  timeoutMs: number;
+  currencies: string[];
+}
+
+export function buildConfig(raw: any): PaymentConfig {
+  return {
+    apiKey: raw.apiKey,
+    retries: raw.retries ?? 3,
+    timeoutMs: raw.timeoutMs,
+    currencies: raw.currencies,
+  };
+}
