{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "debugLog": false,
  "permission": {
    "*": "allow",
    "ask_user_question": "allow",
    "bash": {
      "*": "ask",
      "awk *": "ask",
      "env": "deny",
      "env |*": "deny",
      "env|*": "deny",
      "export -p": "deny",
      "export -p |*": "deny",
      "export -p|*": "deny",
      "gh pr comment *": "ask",
      "gh pr view *": "allow",
      "gh run view *": "allow",
      "git add *": "allow",
      "git branch --contains *": "allow",
      "git branch --show-current": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git merge-base *": "allow",
      "git merge-base HEAD main": "allow",
      "git merge-base HEAD master": "allow",
      "git rev-parse *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "pnpm sst *": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "rm -rf *": "deny",
      "sed *": "allow",
      "set |*": "deny",
      "set|*": "deny",
      "sst *": "deny",
      "sudo *": "ask"
    },
    "ctx_execute": "allow",
    "external_directory": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "todo": "allow"
  },
  "permissionReviewLog": true,
  "yoloMode": false
}