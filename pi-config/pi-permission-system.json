{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "debugLog": false,
  "permission": {
    "*": "allow",
    "ask_user_question": "allow",
    "bash": {
      "*": "ask",
      "awk *": "ask",
      "biome *": "allow",
      "bun install *": "allow",
      "bun add *": "allow",
      "bun remove *": "allow",
      "bun run *": "allow",
      "bun build *": "allow",
      "bun test *": "allow",
      "bun x *": "allow",
      "npm install *": "allow",
      "npm run *": "allow",
      "npm test *": "allow",
      "pnpm install *": "allow",
      "pnpm run *": "allow",
      "pnpm test *": "allow",
      "tsc *": "allow",
      "vitest *": "allow",
      "node *": "allow",
      "env": "deny",
      "env |*": "deny",
      "env|*": "deny",
      "export -p": "deny",
      "export -p |*": "deny",
      "export -p|*": "deny",
      "gh pr comment *": "ask",
      "gh pr view *": "allow",
      "gh run view *": "allow",
      "git add *": "allow",
      "git branch --contains *": "allow",
      "git branch --show-current": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git merge-base *": "allow",
      "git merge-base HEAD main": "allow",
      "git merge-base HEAD master": "allow",
      "git rev-parse *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "pnpm sst *": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "rm -rf *": "deny",
      "rtk git add *": "allow",
      "rtk git branch --contains *": "allow",
      "rtk git branch --show-current": "allow",
      "rtk git diff": "allow",
      "rtk git diff *": "allow",
      "rtk git log *": "allow",
      "rtk git merge-base *": "allow",
      "rtk git merge-base HEAD main": "allow",
      "rtk git merge-base HEAD master": "allow",
      "rtk git rev-parse *": "allow",
      "rtk git status": "allow",
      "rtk git status *": "allow",
      "sed *": "allow",
      "set |*": "deny",
      "set|*": "deny",
      "sst *": "deny",
      "sudo *": "ask"
    },
    "ctx_execute": "allow",
    "external_directory": {
      "*": "ask",
      "~/.cargo/registry/*": "allow",
      "~/Library/Caches/*": "allow",
      "~/.npm/_cacache/*": "allow"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "id_rsa*": "deny",
      "id_ecdsa*": "deny",
      "id_ed25519*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "credentials.*": "deny",
      "*.token": "deny",
      "*secret*": "deny",
      "*password*": "deny",
      "~/.aws/*": "deny",
      "kubeconfig*": "deny",
      "~/.kube/*": "deny",
      ".netrc": "deny",
      "~/.npmrc": "deny"
    },
    "todo": "allow"
  },
  "permissionReviewLog": true,
  "yoloMode": false
}