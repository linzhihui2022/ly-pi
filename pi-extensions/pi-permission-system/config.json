{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "git diff": "allow",
      "git diff *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git branch --show-current": "allow",
      "git merge-base HEAD main": "allow",
      "git merge-base HEAD master": "allow",
      "gh pr comment *": "ask",
      "gh pr view *": "allow",
      "env": "deny",
      "env |*": "deny",
      "env|*": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "set |*": "deny",
      "set|*": "deny",
      "export -p": "deny",
      "export -p |*": "deny",
      "export -p|*": "deny"
    },
    "tool:": {
      "todo": "allow",
      "ask_user_question": "allow",
      "visual_companion_read_events": "allow",
      "visual_companion_stop": "allow",
      "visual_companion_start": "allow",
      "visual_companion_show": "allow",
      "ctx_execute": "allow"
    },
    "external_directory": "ask"
  }
}