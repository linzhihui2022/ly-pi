{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "git diff": "allow",
      "git diff *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git branch --show-current": "allow",
      "git merge-base HEAD main": "allow",
      "git merge-base HEAD master": "allow"
    },
    "tool:": {
      "todo": "allow",
      "ask_user_question": "allow"
    },
    "external_directory": "ask"
  }
}